classDiagram
    class USER {
        id
        yandex_id
        name
        email
    }
    
    class ROLE {
        id
        name
    }
    
    class BUILDING {
        id
        name
        address
    }
    
    class ROOM {
        id
        building_id
        name
    }
    
    class AIR_CONDITIONER {
        id
        room_id
        name
        model
        status
        mode
        target_temperature
    }
    
    class TEMPERATURE_SENSOR {
        id
        room_id
        name
        model
        current_temperature
    }
    
    class SCHEDULE {
        id
        air_conditioner_id
        name
        day_of_week
        specific_date
        start_time
        end_time
        mode
        target_temperature
        periodicity
        is_active
    }
    
    class AC_GROUP {
        id
        name
    }
    
    class REGISTRATION_REQUEST {
        id
        user_id
        status
    }
    
    class USER_ROLE {
        user_id
        role_id
        building_id
    }
    
    USER "1" --o "*" USER_ROLE : has
    ROLE "1" --o "*" USER_ROLE : includes
    USER "1" --o "*" REGISTRATION_REQUEST : requests
    BUILDING "1" --o "*" ROOM : contains
    BUILDING "1" --o "*" USER_ROLE : assigns
    ROOM "1" --o "*" AIR_CONDITIONER : contains
    ROOM "1" --o "*" TEMPERATURE_SENSOR : contains
    AIR_CONDITIONER "1" --o "*" SCHEDULE : has
    AIR_CONDITIONER "*" --o "*" AC_GROUP : includes
